[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://src/presentation/app_shell.gd" id="1_app"]
[ext_resource type="PackedScene" path="res://scenes/ui/title_screen.tscn" id="2_title"]
[ext_resource type="PackedScene" path="res://scenes/ui/settings_screen.tscn" id="3_settings"]

[sub_resource type="Theme" id="Theme_app"]
default_font_size = 18

[node name="App" type="Node"]
script = ExtResource("1_app")

[node name="WorldViewportContainer" type="SubViewportContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
stretch = true

[node name="WorldViewport" type="SubViewport" parent="WorldViewportContainer"]
handle_input_locally = false
size = Vector2i(640, 360)
render_target_update_mode = 4

[node name="WorldRoot" type="Node3D" parent="WorldViewportContainer/WorldViewport"]
unique_name_in_owner = true

[node name="UILayer" type="CanvasLayer" parent="."]

[node name="UIRoot" type="Control" parent="UILayer"]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = SubResource("Theme_app")

[node name="GameplayHUD" type="Control" parent="UILayer/UIRoot"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="BuildPanel" type="PanelContainer" parent="UILayer/UIRoot/GameplayHUD"]
layout_mode = 0
offset_left = 10.0
offset_top = 10.0
offset_right = 280.0
offset_bottom = 66.0

[node name="Margin" type="MarginContainer" parent="UILayer/UIRoot/GameplayHUD/BuildPanel"]
layout_mode = 2
theme_override_constants/margin_left = 9
theme_override_constants/margin_top = 7
theme_override_constants/margin_right = 9
theme_override_constants/margin_bottom = 7

[node name="BuildLabel" type="Label" parent="UILayer/UIRoot/GameplayHUD/BuildPanel/Margin"]
