[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://src/presentation/app_shell.gd" id="1_app"]
[ext_resource type="PackedScene" path="res://scenes/ui/title_screen.tscn" id="2_title"]
[ext_resource type="PackedScene" path="res://scenes/ui/settings_screen.tscn" id="3_settings"]
[ext_resource type="PackedScene" path="res://scenes/ui/first_person_scout.tscn" id="4_scout"]
[ext_resource type="PackedScene" path="res://scenes/ui/equipment_screen.tscn" id="5_equipment"]
[ext_resource type="Script" path="res://src/audio/title_shell_audio.gd" id="6_audio"]
[ext_resource type="Script" path="res://src/ui/ui_button_feedback.gd" id="7_feedback"]

[sub_resource type="Theme" id="Theme_app"]
default_font_size = 18

[node name="App" type="Node"]
script = ExtResource("1_app")

[node name="WorldViewportContainer" type="SubViewportContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
stretch = true

[node name="WorldViewport" type="SubViewport" parent="WorldViewportContainer"]
unique_name_in_owner = true
handle_input_locally = false
size = Vector2i(1920, 1080)
msaa_3d = 2
render_target_update_mode = 4

[node name="WorldRoot" type="Node3D" parent="WorldViewportContainer/WorldViewport"]
unique_name_in_owner = true

[node name="UILayer" type="CanvasLayer" parent="."]

[node name="UIRoot" type="Control" parent="UILayer"]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = SubResource("Theme_app")

[node name="GameplayHUD" type="Control" parent="UILayer/UIRoot"]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="BuildPanel" type="PanelContainer" parent="UILayer/UIRoot/GameplayHUD"]
layout_mode = 0
offset_left = 24.0
offset_top = 24.0
offset_right = 560.0
offset_bottom = 140.0

[node name="Margin" type="MarginContainer" parent="UILayer/UIRoot/GameplayHUD/BuildPanel"]
layout_mode = 2
theme_override_constants/margin_left = 9
theme_override_constants/margin_top = 7
theme_override_constants/margin_right = 9
theme_override_constants/margin_bottom = 7

[node name="BuildLabel" type="Label" parent="UILayer/UIRoot/GameplayHUD/BuildPanel/Margin"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.92, 0.78, 1)
theme_override_font_sizes/font_size = 18
text = "ASTERFOLD\nBRINDLEWICK WALKING DIORAMA"

[node name="HelpPanel" type="PanelContainer" parent="UILayer/UIRoot/GameplayHUD"]
unique_name_in_owner = true
layout_mode = 0
offset_left = 24.0
offset_top = 164.0
offset_right = 720.0
offset_bottom = 400.0

[node name="Margin" type="MarginContainer" parent="UILayer/UIRoot/GameplayHUD/HelpPanel"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 10

[node name="Instructions" type="Label" parent="UILayer/UIRoot/GameplayHUD/HelpPanel/Margin"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.93, 0.95, 1, 1)
theme_override_font_sizes/font_size = 20
text = "MOVE  —  WASD / LEFT STICK\nPEEK  —  SPACE + WASD / RIGHT STICK\nLOOK AROUND  —  V / CONTROLLER Y\nHELP  —  F1 / START\nRETURN TO TITLE  —  ESC / CONTROLLER B"

[node name="FirstPersonScout" parent="UILayer/UIRoot/GameplayHUD" instance=ExtResource("4_scout")]
unique_name_in_owner = true

[node name="TitleScreen" parent="UILayer/UIRoot" instance=ExtResource("2_title")]
unique_name_in_owner = true

[node name="SettingsScreen" parent="UILayer/UIRoot" instance=ExtResource("3_settings")]
unique_name_in_owner = true

[node name="EquipmentScreen" parent="UILayer/UIRoot" instance=ExtResource("5_equipment")]
