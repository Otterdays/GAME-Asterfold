[node name="QuitPromptLabel" type="Label" parent="UILayer/UIRoot/QuitPrompt/Margin/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.92, 0.78, 1)
theme_override_font_sizes/font_size = 24
text = "CLOSE ASTERFOLD?"
