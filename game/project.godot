config_version=5

[application]

config/name="Asterfold"
config/version="0.1.0-dev"
run/main_scene="res://scenes/app/app.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

ContentDB="*res://src/services/content_db.gd"
InputRouter="*res://src/services/input_router.gd"
GameFlow="*res://src/services/game_flow.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

