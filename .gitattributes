* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
*.gd text eol=lf
*.gdshader text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.uid text eol=lf
*.bat text eol=crlf

# Editable binary source art and runtime audio use Git LFS.
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
game/assets/audio/**/*.wav filter=lfs diff=lfs merge=lfs -text
game/assets/audio/**/*.ogg filter=lfs diff=lfs merge=lfs -text
game/assets/audio/**/*.flac filter=lfs diff=lfs merge=lfs -text
